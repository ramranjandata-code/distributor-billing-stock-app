{
  "name": "distributor-billing-stock-app",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "gstr1": "node scripts/generate_monthly_gstr1.cjs",
    "dist-installer": "vite build && electron-builder --win nsis",
    "package-win": "electron-packager . DistroPulse-ERP --platform=win32 --arch=x64 --overwrite --out=dist-desktop --ignore=node_modules"
  },
  "build": {
    "appId": "com.distropulse.erp",
    "productName": "DistroPulse ERP",
    "directories": {
      "output": "output-setup"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DistroPulse ERP"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "lucide-react": "^0.344.0",
    "lz-string": "^1.5.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "gh-pages": "^6.3.0",
    "vite": "^5.1.4"
  }
}
