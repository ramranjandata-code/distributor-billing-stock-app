# =========================================================================
# DISTROPLUS ERP: DUAL GOOGLE DRIVE & SUPABASE CONFIGURATION
# =========================================================================

# Google OAuth 2.0 Credentials (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Target Google Drive Parent Folder ID for Bill PDFs
GOOGLE_DRIVE_FOLDER_ID="15Ub1FksCAldnMYBwxfUTwXzB7Kx5w_8E"

# Supabase PostgreSQL Database Credentials (from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server Port (Default: 3000)
PORT=3000
